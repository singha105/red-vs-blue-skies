{
  "name": "red-vs-blue-skies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node tools/make-icons.mjs",
    "models": "node tools/build-models.mjs",
    "balance": "node tools/balance.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rvbs \"vitest run --config vitest.rules.config.ts\"",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "test:profile": "firebase emulators:exec --only auth,firestore --project demo-rvbs \"EMULATORS=1 playwright test profile.spec\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "peerjs": "^1.5.5",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "firebase-tools": "^15.34.0",
    "peer": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
